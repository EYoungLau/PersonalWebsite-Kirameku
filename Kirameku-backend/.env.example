# 数据库
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 应用密钥
SECRET_KEY=your-secret-key

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://eyounglau.hk

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 上传图片保存在后端项目的 uploads/ 目录。生产环境请将该目录挂载到持久化磁盘。
